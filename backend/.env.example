# Copie para backend/.env. O banco existente é mantido em backend/data.
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
DEMO_MODE=false
APP_TIMEZONE=America/Sao_Paulo
# Gere uma chave: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Opcional: caminho absoluto para banco e uploads em outro disco.
# DATA_DIR=C:/Dados/Comunhao
# Origens web autorizadas, separadas por vírgula. Apps nativos não precisam de CORS.
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
# Necessário para confirmar e-mail e recuperar senha fora da demonstração.
SMTP_URL=
MAIL_FROM=
# Serviço de mensagens do responsável: recebe POST {phone,childName,code,expires_at}.
# Deve entregar o código diretamente ao telefone do responsável.
CONSENT_WEBHOOK_URL=
CONSENT_WEBHOOK_TOKEN=
